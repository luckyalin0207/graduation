# 复制此文件为 .env 并填写实际值

# Django
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-domain.railway.app

# 数据库（Railway 自动注入，本地开发留空用 SQLite）
DATABASE_URL=

# LLM API（可选，用于 AI 对话功能）
LLM_API_KEY=
LLM_MODEL=claude-3-5-haiku-20241022
OPENAI_BASE_URL=https://anyrouter.top/v1

# 邮件（可选）
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ── 企业信息验证 API（可选，不配置则使用爱企查免费接口）──────────────────────
# 企查查 Open API（付费）：https://openapi.qcc.com/
QICHACHA_KEY=
QICHACHA_SECRET=

# 天眼查 Open API（付费）：https://www.tianyancha.com/cloud-other-information/openApi.html
TIANYANCHA_TOKEN=
